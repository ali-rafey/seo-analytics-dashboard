# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Postgres connection string. Local example:
#   postgresql://postgres:postgres@localhost:5432/seo_dashboard
DATABASE_URL=

# Redis (used for SSE pub/sub + realtime caching). Local example:
#   redis://localhost:6379
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Google APIs (GA4 Realtime + Data API, Search Console, PageSpeed Insights)
# ─────────────────────────────────────────────────────────────────────────────
# OAuth client (Web application) — used for per-product user-consented access
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI in your OAuth client must include:
#   {NEXTAUTH_URL}/api/integrations/google/callback

# Server-side API key for PageSpeed Insights (no OAuth needed)
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub (OAuth + repo scanning)
# ─────────────────────────────────────────────────────────────────────────────
# Create a GitHub OAuth App: https://github.com/settings/developers
# Authorization callback URL: {NEXTAUTH_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Meta (Facebook + Instagram) — REQUIRES APP REVIEW + BUSINESS VERIFICATION
# Until approved, the dashboard renders a "pending app review" empty state.
# https://developers.facebook.com/apps/
# Required permissions: pages_read_engagement, instagram_basic, read_insights
# ─────────────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn — REQUIRES MARKETING DEVELOPER PLATFORM APPROVAL
# Until approved, the dashboard renders a "pending app review" empty state.
# https://www.linkedin.com/developers/apps
# ─────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
